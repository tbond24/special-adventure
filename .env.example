# The default Codespaces/local preview requires NO credentials or .env file.
# These optional nonsecret settings are read from the process environment only.
# Node scripts do not automatically load this file or .env.local.
# VACANCY_DEV_HOST=127.0.0.1
# VACANCY_DEV_PORT=8776
# Never copy production, Supabase service-role, database or mail secrets here.

# Optional PostHog development experiment; never required for npm run dev/test.
# The isolated preview denies API access and external connections even if set.
# Set these only in a separately approved test environment. Do not pull Vercel envs.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
POSTHOG_TEST_PROJECT_ID=
# VERCEL_ENV is supplied by Vercel; production is hard-disabled in code.
# HOST must be https://us.i.posthog.com OR https://eu.i.posthog.com for your project.
# PROJECT_TOKEN is browser-public (phc_...), never a personal/admin API secret.
