{
  "rewrites": [
    {
      "source": "/",
      "destination": "/app/index.html"
    },
    {
      "source": "/src/:path*",
      "destination": "/app/src/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/app/assets/:path*"
    },
    {
      "source": "/vendor/:path*",
      "destination": "/app/vendor/:path*"
    },
    {
      "source": "/styles.css",
      "destination": "/app/styles.css"
    },
    {
      "source": "/admin-console.css",
      "destination": "/app/admin-console.css"
    },
    {
      "source": "/admin-design-workspace.css",
      "destination": "/app/admin-design-workspace.css"
    },
    {
      "source": "/404.html",
      "destination": "/app/404.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'none'; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'self' data: blob:; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Vacancy-Preview-Isolated",
          "value": "synthetic-offline-no-production-data"
        }
      ]
    }
  ]
}
